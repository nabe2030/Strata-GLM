From 694c5e00a87f7f604e9857e15b47888d836ba2e5 Mon Sep 17 00:00:00 2001
From: nabe2030 <nabe2030@users.noreply.github.com>
Date: Fri, 16 Oct 2026 08:37:50 +0900
Subject: [PATCH 03/10] glm5: allocate per-layer state only for a verifier's
 own layers

Original summary: glm5: per-layer state only for a verifier's own layers (latent/indexer pools/tails), session K/V pools not carved for glm5 (never read); VRAM report lines

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/core/layer.cpp       | 14 +++++++++++--
 src/core/verify_glm5.cpp | 45 ++++++++++++++++++++++++++++++----------
 src/program/generate.cpp |  8 +++++++
 3 files changed, 54 insertions(+), 13 deletions(-)

diff --git a/src/core/layer.cpp b/src/core/layer.cpp
index 3132871..16f2ec0 100644
--- a/src/core/layer.cpp
+++ b/src/core/layer.cpp
@@ -667,9 +667,19 @@ int64_t qsa_kv_resident() { return g_kv_resident; }
 int64_t qsa_kv_resident_min() { return 20480; }
 uint64_t qsa_kv_host_bytes() { return g_kv_host_bytes; }
 
+namespace {
+/// step2b: glm5-next keeps its K/V in the verifier's own latent cache (verify_glm5.cpp), so the session's per-layer
+/// Qwen-layout K/V pools and indexer pools are never read: they are carved for a few cells only (the RoPE tables, and the
+/// `max_cells` the verifier reads, stay the context's).  STRATA_GLM5_SS_FULL=1: the whole-context pools as before.
+int64_t qsa_plan_cells(const ModelGeometry& g, int64_t max_cells) {
+    static const bool full = [] { const char* v = std::getenv("STRATA_GLM5_SS_FULL"); return v != nullptr && v[0] == '1'; }();
+    return g.is_glm5_next() && !full ? std::min<int64_t>(max_cells, 64) : max_cells;
+}
+}  // namespace
+
 uint64_t qsa_state_bytes(const ModelGeometry& g, int64_t max_cells, bool with_rope, int64_t ring_cells) {
     const QsaShapes s = qsa_shapes(g);
-    const KvPlan p = kv_plan(s, max_cells, ring_cells);
+    const KvPlan p = kv_plan(s, qsa_plan_cells(g, max_cells), ring_cells);
     uint64_t n = 0;
     if (!(g_kv_elastic && p.mode == 0))   // the elastic K/V's pools are in their own VMM range
         n += kv_pool_bytes(s, p.slots, g_kv_hybrid && ring_cells <= 0,
@@ -689,7 +699,7 @@ uint64_t qsa_state_bytes(const ModelGeometry& g, int64_t max_cells, bool with_ro
 uint64_t qsa_state_init(const ModelGeometry& g, int64_t max_cells, void* base, QsaState& st,
                         const QsaState* share_rope, int64_t ring_cells) {
     const QsaShapes s = qsa_shapes(g);
-    const KvPlan p = kv_plan(s, max_cells, ring_cells);
+    const KvPlan p = kv_plan(s, qsa_plan_cells(g, max_cells), ring_cells);
     const int64_t pages = p.pages;
     Cursor c{(uint8_t*) base};
     st.kv_int8 = g_kv_int8 && !g_kv_q4;
diff --git a/src/core/verify_glm5.cpp b/src/core/verify_glm5.cpp
index cb6c8f0..6f29194 100644
--- a/src/core/verify_glm5.cpp
+++ b/src/core/verify_glm5.cpp
@@ -75,6 +75,10 @@ struct Verifier::Glm5 {
     float rms_eps = 1e-5f, ln_eps = 1e-6f, hc_eps = 1e-6f, lb = -5.f, wscale = 1.f, clamp_exp = 0.f, clamp_sh = 0.f;
     int iters = 20, n_slices = 0;
     std::vector<int64_t> kda_index, dsa_index;            // per layer: its ordinal among its kind, or -1
+    // step2b: the per-DSA-layer buffers below (latent, tail, pooled, raw_k/g) hold only THIS verifier's layers [lb, le):
+    // `d0` is the global ordinal of its first DSA layer, `nD_own` their count (a whole-model verifier: 0 and all of them)
+    int64_t d0 = 0, nD_own = 0;
+    int64_t local_dsa(int64_t l) const { return dsa_index[(size_t) l] < 0 ? -1 : dsa_index[(size_t) l] - d0; }
     // per KDA layer
     float* convw = nullptr;          // [nK][C][4]
     float* gate = nullptr;           // [nK][MT][H][S]
@@ -156,6 +160,19 @@ bool Verifier::init_glm5(std::string& err) {
     int64_t nK = 0, nD = 0;
     for (int64_t l = 0; l < g.n_layers; ++l) (g.is_sparse_layer(l) ? m.dsa_index : m.kda_index)[(size_t) l] = g.is_sparse_layer(l) ? nD++ : nK++;
     if (nK != g.n_gdn_layers() || nD != g.n_qsa_layers()) { err = "verify glm5: layer kinds disagree with the geometry"; return false; }
+    // step2b: the latent cache, the indexer tails and pools are allocated for this verifier's own DSA layers only
+    // (STRATA_GLM5_KV_ALL=1: for every DSA layer, as before)
+    m.d0 = 0; m.nD_own = nD;
+    {
+        static const bool all = [] { const char* v = std::getenv("STRATA_GLM5_KV_ALL"); return v && v[0] == '1'; }();
+        if (!all) {
+            int64_t first = -1, cnt = 0;
+            for (int64_t l = lb_; l < le_; ++l)
+                if (m.dsa_index[(size_t) l] >= 0) { if (first < 0) first = m.dsa_index[(size_t) l]; ++cnt; }
+            if (first >= 0) { m.d0 = first; m.nD_own = cnt; } else { m.d0 = 0; m.nD_own = 0; }
+        }
+    }
+    nD = m.nD_own;
     // per-layer device state
     m.convw = m.dev<float>((size_t) nK * m.C * 4);
     m.gate = m.dev<float>((size_t) nK * MT * m.H * m.S);
@@ -228,9 +245,15 @@ bool Verifier::init_glm5(std::string& err) {
                  (long long) m.QLR, (long long) m.KVR, (long long) m.QK, (long long) m.VD, (long long) m.IH, (long long) m.ID,
                  (long long) m.NFF, (long long) m.NFFD, (long long) m.NE, (long long) m.K, (long long) m.cap, m.rms_eps,
                  m.ln_eps, m.hc_eps, m.lb, m.wscale, m.clamp_exp, m.clamp_sh);
-    std::fprintf(stderr, "strata verify: glm5-next window: %lld KDA + %lld DSA layers, %lld dense, %lld-cell latent cache "
-                         "(%.1f MiB, %s)\n", (long long) nK, (long long) nD, (long long) g.n_dense_layers,
+    std::fprintf(stderr, "strata verify: glm5-next window (layers %lld-%lld): %lld KDA + %lld DSA layers (%lld DSA here), %lld dense, %lld-cell latent cache "
+                         "(%.1f MiB, %s)\n", (long long) lb_, (long long) (le_ - 1), (long long) nK, (long long) g.n_qsa_layers(), (long long) nD, (long long) g.n_dense_layers,
                  (long long) m.max_cells, (double) nD * m.max_cells * m.lat_row / 1048576.0, m.lat_q4 ? "q4_0" : "fp16");
+    std::fprintf(stderr, "strata verify: glm5 per-layer state on CUDA%d (layers %lld-%lld): latent %.1f MiB + indexer pool %.1f MiB "
+                         "+ tails/keys %.2f MiB for %lld DSA layers (%lld cells)\n", device_, (long long) lb_, (long long) (le_ - 1),
+                 (double) nD * m.max_cells * m.lat_row / 1048576.0,
+                 (double) nD * (m.max_cells / 4 + 1) * m.ID * 2 / 1048576.0,
+                 ((double) nD * 3 * 2 * m.ID * 4 * 2 + (double) nD * MT * m.ID * 4 * 2) / 1048576.0, (long long) nD,
+                 (long long) m.max_cells);
     return true;
 }
 
