+// step2c (investigation only): STRATA_GLM5_LDUMP=file + STRATA_GLM5_LDUMP_POS=p1,p2,...  appends, for each listed absolute
+// position and each layer, the hand-off state after that layer (R | block output | post | comb, F32) - from the windows
+// and from the chunk path alike - as records {int64 pos, int64 layer, HF floats}
+namespace {
+struct LDump {
+    std::string path;
+    std::vector<int64_t> pos;
+    std::FILE* f = nullptr;
+    bool on() const { return !path.empty() && !pos.empty(); }
+    bool has(int64_t p) const { return std::find(pos.begin(), pos.end(), p) != pos.end(); }
+    void write(int64_t p, int64_t l, const float* h, size_t n) {
+        if (f == nullptr) f = std::fopen(path.c_str(), "ab");
+        if (f == nullptr) return;
+        std::fwrite(&p, 8, 1, f); std::fwrite(&l, 8, 1, f); std::fwrite(h, 4, n, f); std::fflush(f);
+    }
+};
+LDump& ldump() {
+    static LDump d = [] {
+        LDump x;
+        if (const char* v = std::getenv("STRATA_GLM5_LDUMP")) x.path = v;
+        if (const char* v = std::getenv("STRATA_GLM5_LDUMP_POS")) {
+            std::string t = v; size_t i = 0;
+            while (i < t.size()) { size_t j = t.find(',', i); if (j == std::string::npos) j = t.size(); x.pos.push_back(std::atoll(t.substr(i, j - i).c_str())); i = j + 1; }
+        }
+        return x;
+    }();
+    return d;
+}
