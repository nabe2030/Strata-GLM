+// step2c: after a window has run, write the listed positions' per-layer states
+void Verifier::glm5_ldump_window(int T, int64_t pos0) {
+    if (glm_ == nullptr || glm_->ldump_dev == nullptr) return;
+    LDump& d = ldump();
+    const int64_t HF = handoff_floats(*g_);
+    std::vector<float> h((size_t) HF);
+    bool synced = false;
+    for (int t = 0; t < T; ++t) {
+        if (!d.has(pos0 + t)) continue;
+        if (!synced) { cudaStreamSynchronize(cs_); synced = true; }
+        for (int64_t l = lb_; l < le_; ++l) {
+            cudaMemcpy(h.data(), glm_->ldump_dev + ((size_t) l * max_t_ + t) * HF, (size_t) HF * 4, cudaMemcpyDeviceToHost);
+            d.write(pos0 + t, l, h.data(), h.size());
+        }
+        if (glm_->ldump2_dev != nullptr) {
+            const size_t n2 = (size_t) (2 * glm_->N + 2 * glm_->K);
+            std::vector<float> h2(n2);
+            cudaMemcpy(h2.data(), glm_->ldump2_dev + (size_t) t * n2, n2 * 4, cudaMemcpyDeviceToHost);
+            d.write(pos0 + t, 1000 + glm_->ldump2_layer, h2.data(), n2);
+            const size_t K = (size_t) glm_->K, N = (size_t) glm_->N;
+            std::vector<float> h3(2 * K + K * N);
+            std::vector<int32_t> ids(K);
+            cudaMemcpy(ids.data(), glm_->ldump3_ids + (size_t) t * K, K * 4, cudaMemcpyDeviceToHost);
+            for (size_t k = 0; k < K; ++k) { h3[k] = (float) ids[k]; h3[K + k] = 0.f; }
+            cudaMemcpy(h3.data() + 2 * K, glm_->ldump3_dev + (size_t) t * K * N, K * N * 4, cudaMemcpyDeviceToHost);
+            d.write(pos0 + t, 2000 + glm_->ldump2_layer, h3.data(), h3.size());
+        }
+    }
+}
