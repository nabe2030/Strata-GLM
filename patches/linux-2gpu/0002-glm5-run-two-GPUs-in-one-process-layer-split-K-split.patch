From e4040cb76ff5acde76e89d3c09e72b8976bcd0ff Mon Sep 17 00:00:00 2001
From: nabe2030 <nabe2030@users.noreply.github.com>
Date: Fri, 16 Oct 2026 07:09:44 +0900
Subject: [PATCH 02/10] glm5: run two GPUs in one process (--layer-split K
 --split-device D)

Original summary: glm5: two GPUs in one process (--layer-split K --split-device D): local later-GPU verifier, shared pool/RAM tier, mapped hand-off; STRATA_SPLIT_FIRST test knob

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 src/program/generate.cpp | 83 ++++++++++++++++++++++++++++++++++++++--
 1 file changed, 79 insertions(+), 4 deletions(-)

diff --git a/src/program/generate.cpp b/src/program/generate.cpp
index a764fa3..fe85fa8 100644
--- a/src/program/generate.cpp
+++ b/src/program/generate.cpp
@@ -2671,6 +2671,11 @@ int main(int argc, char** argv) {
     strata::core::ModelGeometry g;   // canonical defaults; the model file overrides the MoE shape below
     int64_t K = 10;
     if (glm5_model) { g = glm5_geom; K = glm5_geom.n_expert_used; }   // glm5-next: the whole geometry from its GGUF
+    if (glm5_model && multi_gpu) {   // one process, two GPUs: the windows read the prompt, nothing parked, the expert set stays fixed
+        o.prompt_cache = 0;
+        o.conversation_cache_mib = 0;
+        if (std::getenv("STRATA_MN_ADAPT") == nullptr) o.adapt_swaps = 0;
+    }
     // THE ROPE CONFIG RESOLVES HERE, BEFORE ANY WEIGHT MOVES - the CLI and the model file have both spoken,
     // and `session_init` below builds the rope table from it and captures the kernels reading its constants
     // (rope_scaling.hpp); the only hard constraint is "set before that", and dying on a bad rope key beats
@@ -3973,7 +3978,13 @@ int main(int argc, char** argv) {
     if (multi_gpu) {
         profile_all = profile;
         std::vector<std::pair<int32_t, int32_t>> mine;
+        // STRATA_SPLIT_FIRST=N (step2b, a test knob): only the N hottest pairs of the whole ranking go to the GPU caches
+        // (the RAM copy above keeps the whole ranking), so the caches of a split hold exactly the pairs a one-GPU
+        // run with N pairs resident holds - the A/B that tells a split apart from a different expert placement
+        const size_t first_n = [] { const char* v = std::getenv("STRATA_SPLIT_FIRST"); return v ? (size_t) std::atoll(v) : SIZE_MAX; }();
+        size_t rank_i = 0;
         for (const auto& pr : profile) {
+            if (rank_i++ >= first_n) break;
             const int st = stage_of(pr.first);
             (st == 0 ? mine : stages[(size_t) st - 1]->profile).push_back(pr);
         }
@@ -12027,6 +12038,34 @@ int main(int argc, char** argv) {
         SplitDrive gl_split;
         float* gl_stage_in = nullptr;    // the stage engine's hand-offs (host side, mapped)
         float* gl_stage_out = nullptr;
+        float* gl_hand_host = nullptr;   // the local two-GPU split's hand-off (host side, mapped)
+        // ---- ONE PC, TWO GPUS, ONE PROCESS (step2b).  --layer-split K --split-device D: [0, K) runs in `ver` on CUDA0 and
+        // [K, end) with the head in the later stage's own verifier on CUDA D, each with its own weights, session, expert
+        // cache and residency table (made above for every model); the one expert pool, RAM tier and source are shared.
+        // The hand-off between them is a mapped, portable host buffer (no socket).
+        GpuStage* const gl_gs = (glm5_model && multi_gpu && !remote_head && !stage_mode && stages.size() == 1) ? stages[0].get() : nullptr;
+        if (glm5_model && multi_gpu && gl_gs == nullptr) {
+            std::fprintf(stderr, "strata serve: glm5-next runs on two GPUs in one process with --layer-split K --split-device D "
+                                 "(one later GPU); %zu later GPUs were asked for\n", stages.size());
+            return 2;
+        }
+        strata::core::Verifier* gl_last = &ver_tail;   // the verifier that runs the last layers and holds the head
+        if (gl_gs != nullptr) {
+            const size_t hb = (size_t) strata::kernels::kVerifyMaxT * (size_t) strata::core::Verifier::handoff_floats(g) * sizeof(float);
+            float *hh = nullptr, *hd = nullptr;
+            if (cudaHostAlloc((void**) &hh, hb, cudaHostAllocMapped | cudaHostAllocPortable) != cudaSuccess ||
+                cudaHostGetDevicePointer((void**) &hd, hh, 0) != cudaSuccess) {
+                std::fprintf(stderr, "strata serve: the hand-off allocation failed\n");
+                return 1;
+            }
+            std::memset(hh, 0, hb);
+            gl_hand_host = hh;
+            ver.set_stage(0, split_at[0], nullptr, hd);
+            gl_gs->ver.set_stage(split_at[0], -1, hd, nullptr);
+            gl_chain.push_back(&ver);
+            gl_chain.push_back(&gl_gs->ver);
+            gl_last = &gl_gs->ver;
+        }
         if (glm5_model && (remote_head || stage_mode)) {
             const size_t hb = (size_t) strata::kernels::kVerifyMaxT *
                               (size_t) strata::core::Verifier::handoff_floats(g) * sizeof(float);
@@ -12085,11 +12124,25 @@ int main(int argc, char** argv) {
             }
         }
         if (!ver.init(wt, g, ss, vh, native_head.loaded() ? &native_head : nullptr, o.spec, err) ||
-            (!gl_chain.empty() &&
+            (!gl_chain.empty() && gl_gs == nullptr &&
              !ver_tail.init(wt, g, ss, vh, native_head.loaded() ? &native_head : nullptr, o.spec, err))) {
             std::fprintf(stderr, "strata generate: %s\n", err.c_str());
             return 1;
         }
+        if (gl_gs != nullptr) {
+            const strata::core::OnDevice on(gl_gs->dev);
+            strata::core::VerifyHits vs;
+            vs.d_res = gl_gs->d_res;
+            vs.h_res = host_res.empty() ? nullptr : host_res.data();
+            vs.cache_base = gl_gs->cache.device_slot(0);
+            vs.blob = thits.blob;
+            vs.slot_off = gl_gs->cache.slot_offsets();
+            vs.n_slots = gl_gs->cache.slots();
+            if (!gl_gs->ver.init(gl_gs->wt, g, gl_gs->ss, vs, gl_gs->head.loaded() ? &gl_gs->head : nullptr, o.spec, err)) {
+                std::fprintf(stderr, "strata serve: the later GPU's verifier (CUDA%d): %s\n", gl_gs->dev, err.c_str());
+                return 1;
+            }
+        }
         if (!gl_chain.empty()) {
             const int ns = (int) gl_chain.size();
             gl_split.base = &drive;
@@ -12100,10 +12153,20 @@ int main(int argc, char** argv) {
                 gl_split.cache_base[st] = drive.d.cache_base;
                 gl_split.cache_slot_off[st] = drive.d.cache_slot_off;
                 gl_split.pcie_num[st] = std::max(0, std::min(256, (int) (o.pcie_frac * 256.0 + 0.5)));
+                if (gl_gs != nullptr && st == 1) {
+                    gl_split.cache_base[st] = gl_gs->cache.device_slot(0);
+                    gl_split.cache_slot_off[st] = gl_gs->cache.slot_offsets();
+                    gl_split.pcie_num[st] = std::max(0, std::min(256, (int) (gl_gs->pcie_frac * 256.0 + 0.5)));
+                }
                 if (st + 1 < ns) gl_chain[(size_t) st]->set_next(gl_chain[(size_t) st + 1], &gl_split);
             }
-            ver_tail.set_split(o.spec_split);
-            ver_tail.set_pcie_mode(o.pcie_mode == "dma" ? 0 : o.pcie_mode == "direct" ? 1 : 2);
+            gl_last->set_split(o.spec_split);
+            gl_last->set_pcie_mode(o.pcie_mode == "dma" ? 0 : o.pcie_mode == "direct" ? 1 : 2);
+            if (gl_gs != nullptr)
+                std::fprintf(stderr, "strata serve: two GPUs, one process: layers 0-%lld on CUDA0, %lld-%lld and the head on CUDA%d, "
+                                     "one hand-off per window\n", (long long) (split_at.front() - 1), (long long) split_at.front(),
+                             (long long) (g.n_layers - 1), gl_gs->dev);
+            else
             std::fprintf(stderr, "strata serve: multinode: layers 0-%lld and %lld-%lld here, one hand-off per stage and "
                                  "window\n", (long long) (split_at.front() - 1), (long long) split_at.back(),
                          (long long) (g.n_layers - 1));
@@ -12578,6 +12641,12 @@ int main(int argc, char** argv) {
             };
             pf.stable = [](void* c, int64_t l, int64_t e) -> const uint8_t* { return ((strata::core::ExpertSource*) c)->blob_stable(l, e); };
             pf.prefetch = [](void* c, int64_t l, const int64_t* e, int64_t n) { ((strata::core::ExpertSource*) c)->prefetch_async(l, e, n); };
+            // the later GPU's own expert cache for the chunk path (one process, two GPUs)
+            strata::core::Verifier::Glm5Fetch pf_gs = pf;
+            if (gl_gs != nullptr) {
+                pf_gs.cache_base = gl_gs->cache.device_slot(0);
+                pf_gs.slot_off = reinterpret_cast<decltype(pf_gs.slot_off)>(gl_gs->cache.slot_offsets());
+            }
             // multinode (2026-10-08): each chunk through [0, K1) here, the stage engines' ranges, then [Kn, end) here
             std::vector<std::vector<float>> mn_hand;
             auto mn_prefill = [&](const int32_t* toks, int64_t n_tok, int64_t p0, std::string& e) -> bool {
@@ -12590,6 +12659,12 @@ int main(int argc, char** argv) {
                     if (!ver.prefill_glm5(toks + c0, T, p0 + c0, pf_chunk, pf, e, 0, split_at.front(), nullptr,
                                           mn_hand[0].data()))
                         return false;
+                    if (gl_gs != nullptr) {   // one process, two GPUs: the later GPU's range takes the chunk from the hand-off
+                        if (!gl_gs->ver.prefill_glm5(toks + c0, T, p0 + c0, pf_chunk, pf_gs, e, split_at.front(), -1,
+                                                     mn_hand[0].data(), nullptr))
+                            return false;
+                        continue;
+                    }
                     for (size_t r = 0; r < nr; ++r)
                         if (!gl_links[r]->prefill((int) T, p0 + c0, toks + c0, mn_hand[r].data(), mn_hand[r + 1].data(), e))
                             return false;
@@ -13544,7 +13619,7 @@ int main(int argc, char** argv) {
                     v.windows = 0;
                 };
                 vstat(gl_chain.empty() ? "all layers" : "front layers", ver);
-                if (!gl_chain.empty()) vstat("back layers", ver_tail);
+                if (!gl_chain.empty()) vstat("back layers", *gl_last);
                 for (size_t r = 0; r < gl_links.size(); ++r) {
                     strata::core::StageLink& lk = *gl_links[r];
                     if (lk.windows > 0)
-- 
